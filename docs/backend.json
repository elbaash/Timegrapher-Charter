{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's public profile.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "photoURL": {
          "type": "string",
          "description": "The URL of the user's profile picture."
        }
      }
    },
    "CustomerSession": {
      "title": "Customer Session",
      "description": "A session of timegrapher readings for a customer's watch.",
      "type": "object",
      "properties": {
        "customerName": {
          "type": "string"
        },
        "refNumber": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "userId": {
          "type": "string",
          "description": "The ID of the user who owns this session."
        },
        "readings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "position": {
                "type": "string",
                "enum": [
                  "Dial Up",
                  "Dial Down",
                  "Crown Up",
                  "Crown Down",
                  "Crown Left",
                  "Crown Right",
                  "Unknown"
                ]
              },
              "rate": {
                "type": "string"
              },
              "amplitude": {
                "type": "string"
              },
              "beatError": {
                "type": "string"
              },
              "liftAngle": {
                "type": "string"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "required": ["customerName", "refNumber", "createdAt", "userId", "readings"]
    }
  },
  "auth": {
    "providers": ["anonymous"]
  },
  "firestore": {
    "/users/{userId}/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/CustomerSession" },
      "description": "Stores the timegrapher reading sessions for each user."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores user profile information."
    }
  }
}
